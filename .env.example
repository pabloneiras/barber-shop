# ==============================================================================
# BARBER SHOP - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to '.env' and populate your credentials when deploying to production.
# In local development without credentials, the system automatically runs in
# safe SIMULATION MODE (status = 'simulado').
# ==============================================================================

# Meta WhatsApp Cloud API credentials
META_ACCESS_TOKEN=your_permanent_system_user_access_token_here
META_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
META_API_VERSION=v21.0
META_TEMPLATE_NAME=recordatorio_cita
META_TEMPLATE_LANG=es

# Google Cloud Tasks configuration
GCP_PROJECT=your_google_cloud_project_id
GCP_LOCATION=europe-west1
GCP_QUEUE=recordatorios-whatsapp
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\your\service-account-key.json
